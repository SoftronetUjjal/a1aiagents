# Copy to .env.local and fill in. Vite exposes only VITE_-prefixed variables to
# the browser, which is where the reCAPTCHA *site* key belongs — it is meant to
# ship in the page.
#
# The reCAPTCHA *secret* key is NOT set here and never reaches the browser. It
# lives in the /microservice/contact endpoint, which is what verifies the token
# against Google.

# reCAPTCHA v3 site key for this site's domain. It must pair with the secret
# key already configured in the endpoint — keys are issued and validated as a
# pair, and per-domain. Leave empty and no Google script loads.
VITE_RECAPTCHA_SITE_KEY=

# Optional. The form posts to /microservice/contact on the site's own origin,
# so this normally stays empty. Set it only if the site is ever served from a
# different host than the endpoint, which would also need CORS headers there.
VITE_CONTACT_ENDPOINT=
